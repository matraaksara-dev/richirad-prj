---
// Richirad. — VipTeaser (PRD Amendment v2.1, Bagian 5.1)
// Banner kecil antara LearningPath dan Meetup → arahkan ke /vip
import { Icon } from 'astro-icon/components';
---

<section class="bg-bg">
  <div class="container-page py-10">
    <div class="card flex flex-col items-start justify-between gap-6 border-primary/30 bg-primary-light/60 p-8 md:flex-row md:items-center md:p-10">
      <div class="max-w-xl">
        <p class="eyebrow">
          <Icon name="lucide:graduation-cap" class="h-4 w-4 text-primary" />
          VIP Education
        </p>
        <h2 class="mt-3 text-xl font-semibold leading-[1.4] text-ink sm:text-2xl">
          Ingin jalur lebih intensif?
        </h2>
        <p class="body-secondary mt-2">
          Program edukasi VIP dengan dukungan praktik dan komunitas selama 3 bulan. Skema
          disajikan transparan, tanpa jaminan imbal hasil.
        </p>
      </div>
      <a href="/vip" class="btn-primary shrink-0">
        Kenali VIP Education
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
