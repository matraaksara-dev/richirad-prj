---
// Richirad. — Komunitas & Meetup Malang (PRD 3.8 + Amendment v2.1)
// Background putih, 2 kolom, highlight box; CTA daftar → Telegram
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { SITE } from '../lib/site';
---

<section id="komunitas" class="section-pad scroll-mt-24 bg-bg">
  <div class="container-page">
    <SectionHeading
      eyebrow="Komunitas"
      title="Komunitas yang nyata, bukan hanya online."
      sub="Selain ruang diskusi online, Richirad. secara rutin mengadakan meetup di Kota Malang."
    />

    <div class="mt-12 grid items-center gap-10 lg:grid-cols-2">
      <!-- Teks -->
      <div>
        <p class="lead text-muted">
          Di sini anggota saling kenal, berdiskusi lebih dalam, dan memperkuat komitmen
          belajar bersama — bukan sekadar grup chat biasa.
        </p>

        <div class="mt-8 space-y-4">
          {[
            { icon: 'lucide:calendar', text: 'Meetup offline berkala di Malang' },
            { icon: 'lucide:message-circle', text: 'Suasana santai namun tetap fokus edukasi' },
            { icon: 'lucide:users', text: 'Terbuka untuk pemula yang serius' },
          ].map((item) => (
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[8px] bg-primary-light text-primary">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              <p class="text-[15px] font-medium text-ink-soft">{item.text}</p>
            </div>
          ))}
        </div>

        <a
          href={SITE.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary mt-8"
        >
          <Icon name="lucide:send" class="h-4 w-4" />
          Daftar Meetup Berikutnya
        </a>
      </div>

      <!-- Visual card: mock meetup -->
      <div class="card p-8 sm:p-10" aria-hidden="true">
        <div class="flex flex-wrap gap-2">
          {['Futures', 'Spot', 'Risk Management', 'Psychology', 'Price Action'].map(
            (tag) => (
              <span class="rounded-full bg-primary-light px-3 py-1 text-[13px] font-medium text-primary">
                {tag}
              </span>
            ),
          )}
        </div>

        <div class="mt-8 flex items-center gap-4">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-light text-primary">
            <Icon name="lucide:map-pin" class="h-6 w-6" />
          </span>
          <div>
            <p class="text-[15px] font-semibold text-ink">Meetup</p>
            <p class="body-secondary">Kota Malang</p>
          </div>
        </div>

        <!-- Contoh agenda meetup (ilustrasi) -->
        <ol class="mt-6 space-y-3">
          {[
            'Pembukaan & sharing pengalaman',
            'Diskusi market bersama',
            'Review journal trading member',
          ].map((agenda, i) => (
            <li class="flex items-center gap-3 rounded-[8px] bg-surface p-3.5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-card text-[13px] font-bold text-primary shadow-[var(--shadow-card)]">
                {i + 1}
              </span>
              <p class="text-sm font-medium text-ink-soft">{agenda}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>