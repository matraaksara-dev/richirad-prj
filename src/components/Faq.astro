---
// Richirad. — FAQ (PRD 3.11)
// Background #F3F4F6, accordion native <details> (zero JS)
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

const faqs = [
  {
    q: 'Apakah Richirad. memberikan signal trading?',
    a: 'Tidak. Kami adalah komunitas edukasi. Kami tidak memberikan signal atau rekomendasi aset.',
  },
  {
    q: 'Apakah berbayar?',
    a: 'Saat ini fokus utama kami adalah membangun komunitas edukasi. Informasi lebih lanjut akan disampaikan setelah bergabung.',
  },
  {
    q: 'Saya masih pemula total, boleh gabung?',
    a: 'Sangat boleh. Justru Level 1 dirancang untuk pemula yang serius ingin belajar dengan benar.',
  },
  {
    q: 'Di mana meetup biasanya diadakan?',
    a: 'Di Kota Malang. Lokasi dan jadwal akan diumumkan di dalam komunitas.',
  },
  {
    q: 'Apakah trading bebas risiko?',
    a: 'Tidak. Trading melibatkan risiko kehilangan modal. Edukasi membantu memahami risiko, tetapi keputusan dan tanggung jawab tetap di tangan masing-masing individu.',
  },
];
---

<section id="faq" class="section-pad scroll-mt-24 bg-surface">
  <div class="container-page">
    <SectionHeading
      eyebrow="FAQ"
      title="Pertanyaan yang sering diajukan"
      align="center"
    />

    <div class="mx-auto mt-12 max-w-3xl space-y-3">
      {
        faqs.map((faq, i) => (
          <details class="card overflow-hidden">
            <summary class="flex cursor-pointer select-none items-center justify-between gap-4 p-5 text-[15px] font-semibold text-ink transition-colors hover:text-primary sm:p-6">
              {faq.q}
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-light text-primary" aria-hidden="true">
                <Icon name="lucide:plus" class="faq-icon-plus h-4 w-4" />
                <Icon name="lucide:minus" class="faq-icon-minus h-4 w-4" />
              </span>
            </summary>
            <div class="px-5 pb-6 sm:px-6">
              <p class="body-secondary">{faq.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>