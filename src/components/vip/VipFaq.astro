---
// Richirad. — VIP: FAQ (PRD Amendment v2.1, Bagian 4.4 Section 7) + Disclaimer
import { Icon } from 'astro-icon/components';
import SectionHeading from '../SectionHeading.astro';
import { VIP_DISCLAIMER } from '../../lib/site';

const faqs = [
  {
    q: 'Apakah ini jaminan profit?',
    a: 'Tidak. VIP Education adalah program edukasi dan praktik. Kami tidak menjamin profit atau imbal hasil apa pun. Trading selalu mengandung risiko.',
  },
  {
    q: 'Apa bedanya dengan komunitas reguler?',
    a: 'VIP Education menawarkan jalur belajar yang lebih intensif dengan dukungan akun praktik dan mentoring, di samping akses komunitas reguler.',
  },
  {
    q: 'Berapa lama program berjalan?',
    a: 'Program berlangsung hingga 3 bulan, dengan fase edukasi & praktik intensif di bulan pertama menuju trading mandiri.',
  },
  {
    q: 'Apakah ada risiko kehilangan modal?',
    a: 'Ya. Trading selalu berisiko termasuk kehilangan modal. Edukasi membantu memahami risiko, tetapi keputusan dan tanggung jawab tetap di tangan masing-masing individu.',
  },
];
---

<section id="faq-vip" class="section-pad scroll-mt-24 bg-surface">
  <div class="container-page">
    <SectionHeading
      eyebrow="FAQ"
      title="Pertanyaan seputar VIP Education"
      align="center"
    />

    <div class="mx-auto mt-12 max-w-3xl space-y-3">
      {
        faqs.map((faq) => (
          <details class="card overflow-hidden">
            <summary class="flex cursor-pointer select-none items-center justify-between gap-4 p-5 text-[15px] font-semibold text-ink transition-colors hover:text-primary sm:p-6">
              {faq.q}
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-light text-primary" aria-hidden="true">
                <Icon name="lucide:plus" class="faq-icon-plus h-4 w-4" />
                <Icon name="lucide:minus" class="faq-icon-minus h-4 w-4" />
              </span>
            </summary>
            <div class="px-5 pb-6 sm:px-6">
              <p class="body-secondary">{faq.a}</p>
            </div>
          </details>
        ))
      }
    </div>

    <!-- Full disclaimer VIP -->
    <div class="mx-auto mt-6 max-w-3xl rounded-[8px] border border-border p-5 sm:p-6">
      <div class="flex items-start gap-3">
        <Icon name="lucide:shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
        <p class="caption leading-[1.6]">
          <strong class="font-semibold text-ink-soft">Disclaimer:</strong> {VIP_DISCLAIMER}
        </p>
      </div>
    </div>
  </div>
</section>