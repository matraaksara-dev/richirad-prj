---
// Richirad. — Final CTA Section (PRD 3.12 + Amendment v2.1)
// Background dark, teks putih; CTA utama → Telegram, CTA sekunder → /vip
import { Icon } from 'astro-icon/components';
import { SITE } from '../lib/site';
---

<section class="bg-night">
  <div class="container-page py-16 text-center md:py-24">
    <p class="eyebrow border-white/15 bg-white/5 text-white/70">
      <Icon name="lucide:sparkles" class="h-4 w-4 text-primary" />
      Mulai Perjalananmu
    </p>

    <h2 class="mx-auto mt-6 max-w-3xl text-3xl font-bold leading-[1.25] text-white sm:text-4xl lg:text-5xl">
      Siap belajar trading dengan cara yang lebih sehat?
    </h2>

    <p class="mx-auto mt-5 max-w-xl text-base leading-[1.6] text-white/70 sm:text-lg">
      Gabung Richirad. — komunitas edukasi futures &amp; spot di Malang.
      <span class="font-semibold text-white">Bersama, kita naik level.</span>
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="btn bg-primary px-10 py-4 text-base text-white hover:bg-primary-dark"
      >
        <Icon name="lucide:send" class="h-5 w-5" />
        {SITE.telegramLabel}
      </a>
      <a
        href="/vip"
        class="btn-gold px-8 py-4 text-base"
      >
        Daftar VIP Insider
        <Icon name="lucide:arrow-right" class="h-5 w-5" />
      </a>
    </div>

    <p class="caption mt-6 text-white/50">
      Edukasi • Kebersamaan • Profesional &amp; Aman
    </p>
  </div>
</section>